# Copy to .env and fill in. Never commit .env.
# Docker Compose reads this file for interpolation and passes it to the app.

# --- Required -----------------------------------------------------------
# Long random string (>= 32 chars), e.g. openssl rand -base64 48. Signs sessions/JWTs.
PAYLOAD_SECRET=

# Postgres container credentials. Compose builds the app DATABASE_URL from these.
# URL-encode the password if it contains reserved characters (@ : / ? # %).
POSTGRES_USER=integrit
POSTGRES_PASSWORD=
POSTGRES_DB=integrit

# Public hostname served by Caddy (automatic HTTPS). Use "localhost" for local testing.
DOMAIN=localhost

# --- Email (SMTP) -------------------------------------------------------
# Dev profile: Mailpit (docker compose --profile dev up). UI: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
# Real SMTP in production: set host/port and credentials (465 = implicit TLS,
# 587 = STARTTLS). Leave SMTP_USER empty for servers without auth (Mailpit).
SMTP_USER=
SMTP_PASS=
# From address for outgoing mail; use a domain you control with SPF/DKIM/DMARC set up.
EMAIL_FROM=no-reply@example.com
# Recipient of the new-RFP notification email (the team inbox).
RFP_NOTIFY_TO=

# --- Running Next.js on the host without Docker (npm run dev) -----------
# Compose sets DATABASE_URL itself; only needed when running outside Docker.
# DATABASE_URL=postgres://integrit:change-me@localhost:5432/integrit
# Optional: where uploaded media is stored (default: ./media).
# MEDIA_DIR=
